<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Rule_Change_Email</name>
        <label>Send Rule Change Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>textRuleChangeEmailBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>formulaEmailSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Get_Recipient_User.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>DefaultWorkflowUser</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_Recipient_Email</name>
        <label>Has Recipient Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Email</defaultConnectorLabel>
        <rules>
            <name>Recipient_Has_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaHasRecipientEmail</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Rule_Change_Email</targetReference>
            </connector>
            <label>Recipient Has Email</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>formulaCategory</name>
        <dataType>String</dataType>
        <expression>IF(
OR(ISNULL({!$Record.Priority__c}), {!$Record.Priority__c} &lt; 10),
&quot;Info&quot;,
IF({!$Record.Priority__c} &gt;= 40, &quot;Urgent&quot;, &quot;Service&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>formulaDigestCadenceDisplay</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK(TEXT({!$Record.Digest_Cadence__c})),
&quot;(n/a)&quot;,
TEXT({!$Record.Digest_Cadence__c})
)</expression>
    </formulas>
    <formulas>
        <name>formulaDigestHourDisplay</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK(TEXT({!$Record.Digest_Frequency_Hour__c})),
&quot;(n/a)&quot;,
TEXT({!$Record.Digest_Frequency_Hour__c})
)</expression>
    </formulas>
    <formulas>
        <name>formulaDisplayRuleName</name>
        <dataType>String</dataType>
        <expression>IF(
NOT(ISBLANK({!$Record.Rule_Name__c})),
{!$Record.Rule_Name__c},
TEXT({!$Record.Object_Type__c}) &amp; &quot; &quot; &amp; TEXT({!$Record.Frequency__c})
)</expression>
    </formulas>
    <formulas>
        <name>formulaEmailSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Notification rule removed: &quot; &amp; {!formulaDisplayRuleName}</expression>
    </formulas>
    <formulas>
        <name>formulaHasRecipientEmail</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Get_Recipient_User.Email}))</expression>
    </formulas>
    <formulas>
        <name>formulaHouseholdDisplay</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Household.Id}), &quot;(n/a)&quot;, {!Get_Household.Name})</expression>
    </formulas>
    <formulas>
        <name>formulaIsActiveDisplay</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Is_Active__c}, &quot;Yes&quot;, &quot;No&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaIsSystemDefaultDisplay</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Is_System_Default__c}, &quot;Yes&quot;, &quot;No&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaRecipientUserId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.User__c}), {!$Record.LastModifiedById}, {!$Record.User__c})</expression>
    </formulas>
    <interviewLabel>Auto Notification Rule Change Email Delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Auto Notification Rule Change Email Delete</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Changed_By_User</name>
        <label>Get Changed By User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Household</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.LastModifiedById</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Household</name>
        <label>Get Household</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Recipient_Email</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Household__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Recipient_User</name>
        <label>Get Recipient User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Changed_By_User</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>formulaRecipientUserId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Recipient_User</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK(IF(ISBLANK({!$Record.User__c}), {!$Record.LastModifiedById}, {!$Record.User__c})))</filterFormula>
        <object>Notification_Rule__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>textRuleChangeEmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;A notification rule was removed: &lt;strong&gt;{!formulaDisplayRuleName}&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Rule settings&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Rule name: {!formulaDisplayRuleName}&lt;/li&gt;
&lt;li&gt;Object type: {!$Record.Object_Type__c}&lt;/li&gt;
&lt;li&gt;Category: {!formulaCategory}&lt;/li&gt;
&lt;li&gt;Channels: {!$Record.Channel__c}&lt;/li&gt;
&lt;li&gt;Frequency: {!$Record.Frequency__c}&lt;/li&gt;
&lt;li&gt;Digest cadence: {!formulaDigestCadenceDisplay}&lt;/li&gt;
&lt;li&gt;Digest hour: {!formulaDigestHourDisplay}&lt;/li&gt;
&lt;li&gt;Active: {!formulaIsActiveDisplay}&lt;/li&gt;
&lt;li&gt;Household: {!formulaHouseholdDisplay}&lt;/li&gt;
&lt;li&gt;System default: {!formulaIsSystemDefaultDisplay}&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Changed at: {!$Record.LastModifiedDate}&lt;br/&gt;Changed by: {!Get_Changed_By_User.Name}&lt;/p&gt;</text>
    </textTemplates>
</Flow>
