        </rules>
    </decisions>
    <decisions>
        <name>Need_Revoke_Old_Share</name>
        <label>Need Revoke Old Share</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Should_Create_Share</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Old Share To Revoke</defaultConnectorLabel>
        <rules>
            <name>Revoke_Prior_Team_Share</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fx_IsNew</leftValueReference>
