        <locationY>0</locationY>
        <defaultConnectorLabel>No New FAT</defaultConnectorLabel>
        <rules>
            <name>Create_Share_For_Current_FAT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Financial_Advisor_Team__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Current_FAT</targetReference>
            </connector>
            <label>Create Share For Current FAT</label>
        </rules>
    </decisions>
    <description>Replaces Check_Log_TriggerHandler.createShareRecord. Grants Edit on Check_Log__Share to the Financial Advisor Team public group when FAT is set on insert, or when FAT or Owner changes on update. Revokes the prior team share when FAT changes.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_FATChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Financial_Advisor_Team__c})</expression>
    </formulas>
    <formulas>
        <name>fx_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Check Log: After Save: Team Sharing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Check Log: After Save: Team Sharing</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
