        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Prior_FAT_Has_Group</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.Financial_Advisor_Team__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Financial_Advisor_Team__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Public_Group_ID__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Need_Revoke_Old_Share</targetReference>
        </connector>
        <filterFormula>OR(
    AND(ISNEW(), NOT(ISBLANK({!$Record.Financial_Advisor_Team__c}))),
    ISCHANGED({!$Record.Financial_Advisor_Team__c}),
    ISCHANGED({!$Record.OwnerId})
)</filterFormula>
        <object>Check_Log__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
