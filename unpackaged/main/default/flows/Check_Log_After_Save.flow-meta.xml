        <inputAssignments>
            <field>UserOrGroupId</field>
            <value>
                <elementReference>Get_Current_FAT.Public_Group_ID__c</elementReference>
            </value>
        </inputAssignments>
        <object>Check_Log__Share</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
