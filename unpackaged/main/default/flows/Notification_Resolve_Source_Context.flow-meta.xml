<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Outputs</name>
        <label>Assign Outputs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>householdName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Household_Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sourceDetail</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Source_Detail</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>targetRecordId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Target_Record_Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Route_By_Source_Type</name>
        <label>Route By Source Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Outputs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Source_Is_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sourceType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Case</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Case</targetReference>
            </connector>
            <label>Case</label>
        </rules>
        <rules>
            <name>Source_Is_Task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sourceType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Task</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Task</targetReference>
            </connector>
            <label>Task</label>
        </rules>
        <rules>
            <name>Source_Is_Event</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sourceType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Event</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Event</targetReference>
            </connector>
            <label>Event</label>
        </rules>
    </decisions>
    <description>Resolves household name, source record detail, and target record id for notification delivery.</description>
    <environments>Default</environments>
    <formulas>
        <name>Household_Name</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Household.Name}), &quot;this household&quot;, {!Get_Household.Name})</expression>
    </formulas>
    <formulas>
        <name>Source_Detail</name>
        <dataType>String</dataType>
        <expression>CASE(
  {!sourceType},
  &quot;Case&quot;,
  IF(
    ISBLANK({!Get_Case.Id}),
    &quot;Case details unavailable&quot;,
    IF(
      ISBLANK({!Get_Case.Subject}),
      {!Get_Case.CaseNumber},
      {!Get_Case.CaseNumber} &amp; &quot; - &quot; &amp; {!Get_Case.Subject}
    )
  ),
  &quot;Task&quot;,
  IF(
    ISBLANK({!Get_Task.Id}),
    &quot;Task details unavailable&quot;,
    IF(ISBLANK({!Get_Task.Subject}), &quot;New task&quot;, {!Get_Task.Subject})
  ),
  &quot;Event&quot;,
  IF(
    ISBLANK({!Get_Event.Id}),
    &quot;Event details unavailable&quot;,
    IF(ISBLANK({!Get_Event.Subject}), &quot;New event&quot;, {!Get_Event.Subject})
  ),
  &quot;Open the notification to view the new record.&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Target_Record_Id</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!sourceRecordId}), {!householdId}, {!sourceRecordId})</expression>
    </formulas>
    <interviewLabel>Notification Resolve Source Context {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Notification Resolve Source Context</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
