    <description>Created by CCC (KM) for DAN-117. Stage-based before-save validation with dynamic missing-field messages. Moved sales accepted validations to requirements on the layout.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxDateTime_TodayMinus2Minutes</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.InterviewStartTime} - (2/1440)</expression>
    </formulas>
    <formulas>
        <name>fxNum_StageOrder</name>
        <dataType>Number</dataType>
        <expression>CASE(
