        </defaultConnector>
        <defaultConnectorLabel>Already Has FinServ or No WFA</defaultConnectorLabel>
        <rules>
            <name>Stamp_FinServ_From_WFA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Wizard_Financial_Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Financial_Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
