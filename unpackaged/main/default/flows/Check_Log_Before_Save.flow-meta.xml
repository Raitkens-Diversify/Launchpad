                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Client__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Client_Account</targetReference>
            </connector>
            <label>Need FAT From Client</label>
        </rules>
    </decisions>
