    <decisions>
        <name>Should_Set_Owner</name>
        <label>Should Set Owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Skip Owner</defaultConnectorLabel>
        <rules>
            <name>Set_Owner_From_FAT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Financial_Advisor_Team__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fx_ShouldSetOwner</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_FA_Team_Member</targetReference>
            </connector>
            <label>Set Owner From FAT</label>
        </rules>
    </decisions>
    <description>Replaces Check_Log_TriggerHandler field population and owner assignment. On insert: (1) if Wizard_Financial_Account__c is set and Financial_Account__c is blank, stamp the matching FinServ Financial Account; (2) set Client__c and Financial_Advisor_Team__c from FinServ when present, otherwise from Financial_Account__c (and Client Account FAT as fallback); (3) set OwnerId from the first active Financial Advisor team member. On update: set OwnerId when Financial_Advisor_Team__c changes. Manual Check Logs with no FA lookups are left as entered.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>fx_ShouldSetOwner</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISNEW(), ISCHANGED({!$Record.Financial_Advisor_Team__c}))</expression>
    </formulas>
    <interviewLabel>Check Log: Before Save: Populate Fields and Owner {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Check Log: Before Save: Populate Fields and Owner</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Client_Account</name>
        <label>Get Client Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
