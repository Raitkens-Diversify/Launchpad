        </defaultConnector>
        <defaultConnectorLabel>FAT Already Set</defaultConnectorLabel>
        <rules>
            <name>Need_FAT_From_Client</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Financial_Advisor_Team__c</leftValueReference>
