    <status>Active</status>
    <textTemplates>
        <name>textRuleChangeEmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;A notification rule was {!formulaActionVerb}: &lt;strong&gt;{!formulaDisplayRuleName}&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Rule settings&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Rule name: {!formulaDisplayRuleName}&lt;/li&gt;
