            <targetReference>Get_Recipient_User</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK(IF(ISBLANK({!$Record.User__c}), {!$Record.LastModifiedById}, {!$Record.User__c})))</filterFormula>
        <object>Notification_Rule__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
