&lt;li&gt;Category: {!formulaCategory}&lt;/li&gt;
&lt;li&gt;Channels: {!$Record.Channel__c}&lt;/li&gt;
&lt;li&gt;Frequency: {!$Record.Frequency__c}&lt;/li&gt;
&lt;li&gt;Digest cadence: {!formulaDigestCadenceDisplay}&lt;/li&gt;
&lt;li&gt;Digest hour: {!formulaDigestHourDisplay}&lt;/li&gt;
&lt;li&gt;Active: {!formulaIsActiveDisplay}&lt;/li&gt;
&lt;li&gt;Household: {!formulaHouseholdDisplay}&lt;/li&gt;
&lt;li&gt;System default: {!formulaIsSystemDefaultDisplay}&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;{!formulaChangeDetailsSection}&lt;/p&gt;
&lt;p&gt;Changed at: {!$Record.LastModifiedDate}&lt;br/&gt;Changed by: {!Get_Changed_By_User.Name}&lt;/p&gt;</text>
    </textTemplates>
