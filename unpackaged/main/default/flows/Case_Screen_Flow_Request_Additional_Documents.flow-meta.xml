        <rules>
            <name>Comma_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RemainingAdditionalDocNamesContainsComma</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
