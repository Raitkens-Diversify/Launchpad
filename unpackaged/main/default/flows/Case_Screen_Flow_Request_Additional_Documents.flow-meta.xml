        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>FirstEntryinTextAdditionalDocNames</name>
        <dataType>String</dataType>
        <expression>TRIM(LEFT({!RemainingEntriesAdditionalDocNamesText}, FIND(&quot;,&quot;, {!RemainingEntriesAdditionalDocNamesText})-1))</expression>
    </formulas>
    <formulas>
        <name>RemainingAdditionalDocNamesContainsComma</name>
        <dataType>Boolean</dataType>
        <expression>IF(CONTAINS({!RemainingEntriesAdditionalDocNamesText},&quot;,&quot;),TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>UpdateRemainingEntries</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT({!RemainingEntriesAdditionalDocNamesText}, LEN({!RemainingEntriesAdditionalDocNamesText})-FIND(&quot;,&quot;, {!RemainingEntriesAdditionalDocNamesText})))</expression>
    </formulas>
