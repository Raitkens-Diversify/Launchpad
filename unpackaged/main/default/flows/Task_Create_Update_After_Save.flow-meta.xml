    <formulas>
        <description>formula that assigns upcoming monday as account populated date or principal review completed date if the updates were made on friday, saturday, or sunday.</description>
        <name>forAssignedDate</name>
        <dataType>Date</dataType>
        <expression>CASE(
    WEEKDAY({!$Flow.CurrentDate}),
    6, {!$Flow.CurrentDate} + 3,  
    7, {!$Flow.CurrentDate} + 2, 
    1, {!$Flow.CurrentDate} + 1, 
    {!$Flow.CurrentDate} 
)</expression>
    </formulas>
