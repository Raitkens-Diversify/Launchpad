<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>UX_Rating_Range</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISBLANK(UX_Rating__c)) &amp;&amp; (UX_Rating__c &lt; 1 || UX_Rating__c &gt; 5)</errorConditionFormula>
    <errorDisplayField>UX_Rating__c</errorDisplayField>
    <errorMessage>UX Rating must be between 1 and 5.</errorMessage>
</ValidationRule>
