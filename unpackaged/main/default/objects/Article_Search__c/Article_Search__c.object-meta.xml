    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Analytics log of help-center searches. One row per submitted search (Search_Type__c Full/Fallback/Fuzzy) or, from Phase 3, per typeahead. Zero-result rows (Result_Count__c = 0) are the first gap report; rows with a top result but no Clicked_Article_Id__c are the searched-but-never-clicked report. logClick updates the row in place when the user opens a result, so rows are no longer strictly append-only. Who/when = CreatedById/CreatedDate.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Article Search</label>
    <nameField>
        <displayFormat>AS-{000000}</displayFormat>
        <label>Article Search Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Article Searches</pluralLabel>
    <searchLayouts />
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
