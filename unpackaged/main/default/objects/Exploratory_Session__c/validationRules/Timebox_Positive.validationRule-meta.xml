<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Timebox_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Timebox_Minutes__c)), Timebox_Minutes__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Timebox_Minutes__c</errorDisplayField>
    <errorMessage>Timebox must be a positive number of minutes.</errorMessage>
</ValidationRule>
