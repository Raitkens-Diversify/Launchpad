<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
	<masterLabel>Task Comment Related List</masterLabel>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
        name="recordId"
        type="String"
        label="Record Id"
        description="Task record Id – required when used on a non-record Experience Cloud page."
      />
            <property
        name="sobjectLabelPlural"
        type="String"
        label="Header Label"
        default="Task Comments"
        description="Label shown in the card header, e.g. Task Comments."
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
