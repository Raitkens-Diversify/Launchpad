<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Arc Related Work</masterLabel>
    <description
  >Cases and tasks related to the contact or household on the page, behind a Cases/Tasks tab strip.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
        name="cardLabel"
        type="String"
        label="Card Heading"
        default="Related Work"
      />
            <property
        name="recordId"
        type="String"
        label="Record Id"
        description="Leave blank to take the record from the page URL."
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
