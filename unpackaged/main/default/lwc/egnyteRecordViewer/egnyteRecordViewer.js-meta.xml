<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Egnyte Record Viewer</masterLabel>
    <description>Embeds Egnyte directly for a record by resolving folder path and URL via EgnyteController.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property
                name="recordId"
                type="String"
                label="Record Id"
                description="Automatically populated on record pages."
            />
            <property
                name="pageHeight"
                type="String"
                label="Egnyte Height"
                default="600px"
                description="Minimum and initial height of the Egnyte iframe."
            />
        </targetConfig>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="recordId"
                type="String"
                label="Record Id"
                description="Bind to {!recordId} on record detail pages. Leave blank to resolve from the page URL."
            />
            <property
                name="pageHeight"
                type="String"
                label="Egnyte Height"
                default="600px"
                description="Minimum and initial height of the Egnyte iframe."
            />
            <property
                name="useTestConfig"
                type="Boolean"
                label="Use Test Config (deprecated)"
                default="false"
                description="Deprecated. No longer used."
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
