<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Arc Navigation</masterLabel>
    <description>Vertical Arc sidebar navigation for LWR Experience sites.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="menuName"
                type="String"
                default="Arc"
                label="Navigation Menu Name"
                description="Reserved for future dynamic menu support. Navigation is static."
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
