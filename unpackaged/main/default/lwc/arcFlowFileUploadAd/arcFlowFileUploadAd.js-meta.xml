<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>ARC Flow File Upload (Advertising)</masterLabel>
    <description>LWR port of cmp_FileUpload for the ARC-site Advertising Review flow copies.</description>
    <targets>
        <target>lightning__FlowScreen</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="fileType" type="String[]" label="Accepted File Types" />
            <property name="label" type="String" label="Label" />
            <property name="multiple" type="Boolean" label="Allow Multiple Files" />
            <property name="disabled" type="Boolean" label="Disabled" />
            <property name="contentVersionIds" type="String" label="Content Version Ids" role="outputOnly" />
            <property name="recordId" type="String" label="Related Record Id" />
            <property name="advertisingType" type="String" label="Advertising Type" />
            <property name="flowInterviewId" type="String" label="Flow Interview Id" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
