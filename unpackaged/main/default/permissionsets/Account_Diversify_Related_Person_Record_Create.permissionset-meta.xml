<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants the DRP custom permission which allows users to route to a DRP creation screen instead of the Wizard.  Also grants read access to Advisor_Group__c object.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Account - Diversify Related Person Record Create</label>
    <classAccesses>
        <apexClass>AdvisorClientViewToggleController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ProspectOrClientController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customPermissions>
        <enabled>true</enabled>
        <name>Create_DRP_Standard</name>
    </customPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Advisor_Group__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <recordTypeVisibilities>
        <recordType>PersonAccount.Diversify_Related_Person</recordType>
        <visible>true</visible>
    </recordTypeVisibilities>
</PermissionSet>
