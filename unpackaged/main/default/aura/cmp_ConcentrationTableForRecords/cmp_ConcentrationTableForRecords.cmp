<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId"  controller="ConcentrationTableHelper">
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="caseObj" type="Case"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <!--<div class="container-fluid">-->
    <lightning:card>
        <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-table_col-bordered slds-table_fixed-layout slds-table_resizable-cols">
            <tbody>
                <tr class="slds-line-height_reset">
                    <td><div title="Product Type">Product Type</div></td>
                    <td><div title="Total Amount In Asset Class (including today’s purchases)">Total Amount In Asset Class</div><div>(including today’s purchases)</div></td>
                    <td><div title="Total Amount in Asset Class (as a % of Net Worth)">Total Amount in Asset Class</div><div>(as a % of Net Worth)</div></td>
                    <td><div title="All Securitized Alt Investments (as a % of Net Worth)">All Securitized Alt Investments</div><div>(as a % of Net Worth)</div></td>
                </tr>
            <!--</thead>
            <tbody>-->
                <tr class="slds-hint-parent">
                    <td>Securitized Private Real Estate</td>
                    <td>${!v.caseObj.SREP_Total_including_Today__c}</td>
                    <td>{!v.caseObj.SREP_Total_as_of_Net_Worth__c}%</td>
                    <td rowspan="6">{!v.caseObj.ASAA_as_a_of_Net_Worth__c}%</td>
                </tr>
                <tr class="slds-hint-parent">
                    <td>Private Equity</td>
                    <td>${!v.caseObj.PE_Total_including_Today__c}</td>
                    <td>{!v.caseObj.PE_Total_as_of_Net_Worth__c}%</td>
                </tr>
                <tr class="slds-hint-parent">
                    <td>Private Credit</td>
                    <td>${!v.caseObj.PC_Total_including_Today__c}</td>
                    <td>{!v.caseObj.PC_Total_as_of_Net_Worth__c}%</td>
                </tr>
                <tr class="slds-hint-parent">
                    <td>Interval Funds</td>
                    <td>${!v.caseObj.IF_Total_including_Today__c}</td>
                    <td>{!v.caseObj.IF_Total_as_of_Net_Worth__c}%</td>
                </tr>
                <tr class="slds-hint-parent">
                    <td>Energy Programs</td>
                    <td>${!v.caseObj.EP_Total_including_Today__c}</td>
                    <td>{!v.caseObj.EP_Total_as_of_Net_Worth__c}%</td>
                </tr>
                <tr class="slds-hint-parent">
                    <td>Structured Notes</td>
                    <td>${!v.caseObj.SN_Total_including_Today__c}</td>
					<td>{!v.caseObj.SN_Total_as_of_Net_Worth__c}%</td>
                </tr>
            </tbody>
        </table>
    </lightning:card>
    <!--</div>-->
</aura:component>