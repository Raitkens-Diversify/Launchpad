<aura:component implements="lightning:availableForFlowScreens" access="global">
    <aura:attribute name="fieldLabel" type="String" default=""/>
    <aura:attribute name="defaultValue" type="String" default=""/>
    <aura:attribute name="dataType" type="String" default=""/>
    <div class="slds-p-bottom_medium">
        <aura:if isTrue="{!v.dataType=='checkbox'}">
            <lightning:input label="{!v.fieldLabel}"
                             checked="{!v.defaultValue}"
                             type="{!v.dataType}"
                             disabled="true"
                             />
            <aura:set attribute="else">
                <lightning:input label="{!v.fieldLabel}"
                                 value="{!v.defaultValue}"
                                 type="{!v.dataType}"
                                 disabled="true"
                                 />
            </aura:set>
        </aura:if>
        
    </div>
</aura:component>