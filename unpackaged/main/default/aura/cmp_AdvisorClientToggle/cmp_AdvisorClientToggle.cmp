<aura:component controller="AdvisorClientViewToggleController" implements="flexipage:availableForAllPageTypes,force:hasRecordId" access="global">
    <aura:attribute name="viewState" type="String"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    <div class="slds-align_absolute-center" style="height:5rem;">
        <aura:if isTrue="{!v.viewState == 'Diversify'}">
            <lightning:buttonGroup>
                <lightning:button label="Diversify" onclick="{!c.handleClick}" variant="brand"/>
                <lightning:button label="Client" onclick="{!c.handleClick}"/>
            </lightning:buttonGroup>
            <aura:set attribute="else">
                <lightning:buttonGroup>
                    <lightning:button label="Diversify" onclick="{!c.handleClick}"/>
                    <lightning:button label="Client" onclick="{!c.handleClick}" variant="brand"/>
                </lightning:buttonGroup>
            </aura:set>
        </aura:if> 
        
    </div>
</aura:component>