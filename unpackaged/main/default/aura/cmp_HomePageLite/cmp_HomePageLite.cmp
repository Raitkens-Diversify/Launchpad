<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes" access="global" >
    
    <aura:attribute name="showScreen1" type="boolean" default="true"/>
    <aura:attribute name="showScreen2" type="boolean" default="false"/>
    <aura:attribute name="openFlow" type="boolean" default="false" />
    <lightning:card>
    <img src="data:image/png;base64,"/>
    <aura:if isTrue="{!v.showScreen1}">
        <lightning:card>
            <div>
                <lightning:button variant="brand" label="New Order" title="Brand action" onclick="{! c.handleNewOrderClick }" />
            </div>
            <div>
                <lightning:button variant="brand" label="New Advertising Requests" title="Brand action" onclick="{! c.handleClick }" />
                
            </div>
            <div>
                <lightning:button variant="brand" label="Enter New Check Log" title="Brand action" onclick="{! c.handleClick }" />
                
            </div>
        </lightning:card>
    </aura:if>
    <aura:if isTrue="{!v.showScreen2}">
        <lightning:card>
            <div>
                <lightning:button variant="brand" label="New Investment Ticket" title="Brand action" onclick="{! c.handleClick }" />
            </div>
            <div>
                <lightning:button variant="brand" label="New Servicing Request" title="Brand action" onclick="{! c.handleClick }" />
            </div>
            
            <div>
                <lightning:button variant="brand" label="New Client" title="Brand action" onclick="{! c.handleNewClientClick }" />
            </div>
        </lightning:card>
    </aura:if>
    <aura:if isTrue="{!v.openFlow}">
        <lightning:card>
            <lightning:flow aura:id="flowData" class="flow"/>
        </lightning:card>
    </aura:if> 
        </lightning:card>
</aura:component>